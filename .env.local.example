# =============================================================================
# 환경변수 예시 파일
# -----------------------------------------------------------------------------
# 이 파일을 복사해서 ".env.local" 이라는 이름으로 만들고 실제 키를 채워 넣으세요.
# (.env.local 은 .gitignore 에 등록되어 있어 저장소에 올라가지 않습니다)
#
# 키가 없어도 앱은 정상 실행됩니다. 키가 없는 소스는 자동으로 "예시 데이터"로
# 동작하고, 키를 채워 넣으면 그 소스만 실제 데이터로 전환됩니다. (PRD 8장)
# =============================================================================

# --- 쇼핑: 네이버쇼핑 (즉시 발급 가능) ---
# 발급: https://developers.naver.com/apps  → 검색 API 사용 설정
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 쇼핑: 11번가 (셀러오피스에서 발급) ---
# 발급: https://openapi.11st.co.kr
ELEVENST_API_KEY=

# --- 알뜰폰은 API 키가 필요 없습니다 ---
# 알뜰폰허브/폰비/모요/아요는 "가져오기" 버튼으로 직접 크롤링합니다.
